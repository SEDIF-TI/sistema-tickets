# =========================================================================
# Variables del frontend (Vite)
# =========================================================================
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env
#
# ATENCION: todo lo que empiece por VITE_ se incrusta en el bundle que
# descarga el navegador. Es informacion PUBLICA. Nunca pongas aqui
# contrasenas, tokens ni claves de API.
# =========================================================================

# URL base de la API.
#   Desarrollo local:  http://localhost:8080/api
#   Produccion:        /api   (mismo origen, lo enruta el reverse proxy)
VITE_API_URL=http://localhost:8080/api

# Usuario publico del bot de Telegram, usado para construir el enlace de
# vinculacion desde la pantalla de perfil. NO es el token: el token es un
# secreto y vive solo en el .env de la raiz, del lado del backend.
VITE_TELEGRAM_BOT_USERNAME=Notificaciones_SEDIF_bot
