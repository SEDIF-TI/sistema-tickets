# =========================================================================
# .gitignore raiz — sistema-tickets
# =========================================================================

# --- SECRETOS: nunca se versionan ---------------------------------------
# Se ignora .env en cualquier nivel del arbol, junto con sus variantes.
# La excepcion explicita (!) mantiene .env.example dentro de git, que es
# la plantilla que el equipo copia al clonar.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Claves y certificados
*.pem
*.key
*.p12
*.jks
*.keystore
*.crt

# Archivos de configuracion con credenciales reales.
# application.properties y application-prod.properties SI se versionan:
# no contienen secretos, solo referencias ${VARIABLE}.
application-local.properties
application-secret.properties
**/src/main/resources/application-local.properties

# --- Backend (Maven / Java) ---------------------------------------------
backend/target/
target/
*.class
*.jar
*.war
!**/.mvn/wrapper/maven-wrapper.jar
HELP.md

# --- Frontend (Node / Vite) ---------------------------------------------
frontend/node_modules/
node_modules/
frontend/dist/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editores / IDE -----------------------------------------------------
# La configuracion personal de VS Code no se versiona, pero launch.json si:
# es lo que arranca el backend con la extension de Spring Boot, que es el
# flujo de desarrollo del equipo. Sin el, quien clone abre el proyecto sin
# ninguna configuracion de arranque y tiene que rehacerla a mano.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath
.factorypath

# --- Sistema operativo --------------------------------------------------
.DS_Store
Thumbs.db

# --- Logs y temporales --------------------------------------------------
logs/
*.log
*.tmp
*.bak

# --- Volumenes y datos locales de Docker --------------------------------
postgres_data/
pgdata/

# --- Respaldos de base de datos (pueden contener datos personales) ------
*.sql.gz
*.dump
backup/

# Configuracion local de Claude Code (herramienta de desarrollo, no del proyecto)
.claude/
